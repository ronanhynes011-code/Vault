<Window x:Class="Vault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0C"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0A0A0C"/>
        <SolidColorBrush x:Key="BgPanel" Color="#141418"/>
        <SolidColorBrush x:Key="BgCard" Color="#1C1C22"/>
        <SolidColorBrush x:Key="AccentGold" Color="#D4AF37"/>
        <SolidColorBrush x:Key="AccentGoldHover" Color="#F0C75E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#888890"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2A32"/>

        <Style x:Key="VaultButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252530"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource VaultButton}">
            <Setter Property="Background" Value="{StaticResource AccentGold}"/>
            <Setter Property="Foreground" Value="#0A0A0C"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentGoldHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="12" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="12,0,0,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="24,28,24,20">
                            <TextBlock Text="Vault" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                            <TextBlock Text="Executor Panel" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="12,0">
                            <Button Style="{StaticResource VaultButton}" HorizontalContentAlignment="Left" Margin="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25A1;" Margin="0,0,12,0" Foreground="{StaticResource AccentGold}"/>
                                    <TextBlock Text="Overview"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource VaultButton}" HorizontalContentAlignment="Left" Margin="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25CB;" Margin="0,0,12,0" Foreground="{StaticResource AccentGold}"/>
                                    <TextBlock Text="Account"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource VaultButton}" HorizontalContentAlignment="Left" Margin="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2726;" Margin="0,0,12,0" Foreground="{StaticResource AccentGold}"/>
                                    <TextBlock Text="Update Log"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="{StaticResource BorderColor}" Margin="8,16,8,8"/>

                            <Button Style="{StaticResource VaultButton}" HorizontalContentAlignment="Left" Margin="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25C8;" Margin="0,0,12,0" Foreground="#5865F2"/>
                                    <TextBlock Text="Discord"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="2" Background="{StaticResource BgCard}" Margin="12,0,12,16" CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentGold}" Margin="0,0,12,0">
                                    <TextBlock Text="V" Foreground="#0A0A0C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VaultUser" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Signed in" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,16">
                        <Grid>
                            <TextBlock Text="Overview" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource VaultButton}" Width="40" Margin="0,0,8,0" Click="Minimize_Click">
                                    <TextBlock Text="&#x2014;"/>
                                </Button>
                                <Button Style="{StaticResource VaultButton}" Width="40" Click="Close_Click">
                                    <TextBlock Text="&#x2715;"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                        <StackPanel>
                            <TextBlock Text="License" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource BgPanel}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="16">
                                        <TextBlock Text="Plan" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="Vault Premium" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                    <Separator Background="{StaticResource BorderColor}"/>
                                    <Grid Margin="16">
                                        <TextBlock Text="Expires" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="Lifetime" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Executor" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource BgPanel}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="8,8,0,0" Padding="12,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Script Editor" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    </Border>

                                    <TextBox x:Name="ScriptBox" Grid.Row="1"
                                             Background="Transparent"
                                             Foreground="#E0E0E0"
                                             BorderThickness="0"
                                             Padding="12"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             MinHeight="220"
                                             Text="-- Vault Executor&#x0a;print(&quot;Hello from Vault!&quot;)"/>

                                    <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="0,0,8,8" Padding="12,10" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="InjectButton" Style="{StaticResource VaultButton}" Width="100" Margin="0,0,10,0" Click="InjectButton_Click">
                                                    <TextBlock Text="Inject"/>
                                                </Button>
                                                <Button x:Name="ExecuteButton" Style="{StaticResource PrimaryButton}" Width="100" Click="ExecuteButton_Click">
                                                    <TextBlock Text="Execute"/>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="StatusText" Text="Not Attached" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="Compatibility" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource BgPanel}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="16">
                                        <TextBlock Text="Vault Version" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="1.0.0" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                    <Separator Background="{StaticResource BorderColor}"/>
                                    <Grid Margin="16">
                                        <TextBlock Text="Roblox Version" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="Latest" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Popup x:Name="AttachedPopup" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Placement="Top" HorizontalOffset="0" VerticalOffset="40" AllowsTransparency="True" StaysOpen="False">
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F512;" FontSize="18" Foreground="{StaticResource AccentGold}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Attached to Client" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                        <TextBlock Text="Vault is ready." FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

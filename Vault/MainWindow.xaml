<Window x:Class="Vault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault" Height="640" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#07070A"
        Foreground="#E8E8E8"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <SolidColorBrush x:Key="BgDeep" Color="#07070A"/>
        <SolidColorBrush x:Key="BgDark" Color="#0B0B10"/>
        <SolidColorBrush x:Key="BgPanel" Color="#111118"/>
        <SolidColorBrush x:Key="BgCard" Color="#17171F"/>
        <SolidColorBrush x:Key="BgEditor" Color="#0A0A0F"/>
        <SolidColorBrush x:Key="Accent" Color="#D4AF37"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#F0C75E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EAEAEA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#70707A"/>
        <SolidColorBrush x:Key="TextDim" Color="#46464E"/>
        <SolidColorBrush x:Key="Border" Color="#1A1A22"/>
        <SolidColorBrush x:Key="BorderLight" Color="#262630"/>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#181820"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWinBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A1414"/>
                    <Setter Property="Foreground" Value="#FF7070"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Top nav icon button -->
        <Style x:Key="TopIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Underline" Grid.Row="1" Background="{StaticResource Accent}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Underline" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopIconBtnActive" TargetType="Button" BasedOn="{StaticResource TopIconBtn}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Background="{StaticResource Accent}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar button (small, text-based) -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0B0BA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#181820"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBtnAccent" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F1A10"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Script tab (Real-style top strip tab) -->
        <Style x:Key="ScriptTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6,32,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="2,3,2,3">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Margin="14,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#181820"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScriptTabBtnActive" TargetType="Button" BasedOn="{StaticResource ScriptTabBtn}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#181820"
                                CornerRadius="6" Margin="2,3,2,3"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Margin="14,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseDot" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A1414"/>
                                <Setter Property="Foreground" Value="#FF7070"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Ambient glow background -->
        <Border CornerRadius="10">
            <Border.Background>
                <RadialGradientBrush Center="0.2,0.0" GradientOrigin="0.2,0.0"
                                     RadiusX="1.1" RadiusY="1.1">
                    <GradientStop Color="#1A1408" Offset="0"/>
                    <GradientStop Color="#0A0A0E" Offset="0.35"/>
                    <GradientStop Color="#07070A" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#D4AF37" BlurRadius="36" Opacity="0.10" ShadowDepth="0"/>
            </Border.Effect>
        </Border>

        <!-- Window shell -->
        <Border CornerRadius="10" Background="Transparent"
                BorderBrush="#1A1A22" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand (left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Margin="16,0,0,0" VerticalAlignment="Center">
                        <!-- Vault dial logo -->
                        <Grid Width="26" Height="26" Margin="0,0,11,0">
                            <Ellipse Width="20" Height="20" Stroke="{StaticResource Accent}"
                                     StrokeThickness="1.6" Fill="Transparent"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#D4AF37" BlurRadius="14"
                                                      Opacity="0.85" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="4" Height="4" Fill="{StaticResource Accent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Width="1.3" Height="6" Fill="{StaticResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <Rectangle Width="1.3" Height="6" Fill="{StaticResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            <Rectangle Width="6" Height="1.3" Fill="{StaticResource Accent}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <Rectangle Width="6" Height="1.3" Fill="{StaticResource Accent}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Rectangle Width="2.5" Height="8" Fill="{StaticResource Accent}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       RadiusX="1" RadiusY="1"/>
                            <Rectangle Width="1.2" Height="2.5" Fill="{StaticResource Accent}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                        </Grid>
                        <TextBlock Text="Vault" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nav icons (center) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="NavCodeBtn" Style="{StaticResource TopIconBtnActive}"
                                Click="NavCode_Click" ToolTip="Code">
                            <Path Data="M14.6,16.6 L19.2,12 L14.6,7.4 L16,6 L22,12 L16,18 L14.6,16.6 M9.4,16.6 L4.8,12 L9.4,7.4 L8,6 L2,12 L8,18 L9.4,16.6 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="NavAccountBtn" Style="{StaticResource TopIconBtn}"
                                Click="NavAccount_Click" ToolTip="Account">
                            <Path Data="M12,4 A4,4 0 0,1 16,8 A4,4 0 0,1 12,12 A4,4 0 0,1 8,8 A4,4 0 0,1 12,4 M12,14 C16.42,14 20,15.79 20,18 L20,20 L4,20 L4,18 C4,15.79 7.58,14 12,14 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="NavSettingsBtn" Style="{StaticResource TopIconBtn}"
                                Click="NavSettings_Click" ToolTip="Settings">
                            <Path Data="M19.14,12.94 c0.04,-0.3 0.06,-0.61 0.06,-0.94 c0,-0.32 -0.02,-0.64 -0.07,-0.94 l2.03,-1.58 c0.18,-0.14 0.23,-0.41 0.12,-0.61 l-1.92,-3.32 c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22 l-2.39,0.96 c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94 L14.4,2.81 c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41 h-3.84 c-0.24,0 -0.43,0.17 -0.47,0.41 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 c-0.22,-0.08 -0.47,0 -0.59,0.22 L2.74,8.87 c-0.12,0.21 -0.08,0.47 0.12,0.61 l2.03,1.58 C4.84,11.36 4.8,11.69 4.8,12 s0.02,0.64 0.07,0.94 l-2.03,1.58 c-0.18,0.14 -0.23,0.41 -0.12,0.61 l1.92,3.32 c0.12,0.22 0.37,0.29 0.59,0.22 l2.39,-0.96 c0.5,0.38 1.03,0.7 1.62,0.94 l0.36,2.54 c0.05,0.24 0.24,0.41 0.48,0.41 h3.84 c0.24,0 0.44,-0.17 0.47,-0.41 l0.36,-2.54 c0.59,-0.24 1.13,-0.56 1.62,-0.94 l2.39,0.96 c0.22,0.08 0.47,0 0.59,-0.22 l1.92,-3.32 c0.12,-0.22 0.07,-0.47 -0.12,-0.61 L19.14,12.94 z M12,15.6 c-1.98,0 -3.6,-1.62 -3.6,-3.6 s1.62,-3.6 3.6,-3.6 s3.6,1.62 3.6,3.6 S13.98,15.6 12,15.6 z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Window controls (right) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WinBtn}" Click="Minimize_Click">
                            <TextBlock Text="&#x2014;" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Click="Maximize_Click">
                            <TextBlock Text="&#x25A1;" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource CloseWinBtn}" Click="Close_Click">
                            <TextBlock Text="&#x2715;" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- BODY -->
                <Grid Grid.Row="1">

                    <!-- ============ CODE VIEW ============ -->
                    <Grid x:Name="ViewCode">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <!-- Script tabs strip -->
                        <Border Grid.Row="0" Background="#0A0A0F"
                                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ScriptTabsPanel" Orientation="Horizontal"
                                                Margin="6,0,0,0"/>
                                </ScrollViewer>

                                <Button Grid.Column="1" Style="{StaticResource ToolBtn}"
                                        Click="AddScriptTab_Click"
                                        Margin="4,0,10,0" Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="+" FontSize="15" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Toolbar -->
                        <Border Grid.Row="1" Background="#0D0D13"
                                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource ToolBtn}" Click="ExecuteButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x25B6;" FontSize="9" Margin="0,0,7,0"/>
                                            <TextBlock Text="Execute"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolBtn}" Click="Clear_Click">
                                        <TextBlock Text="Clear"/>
                                    </Button>
                                    <Button Style="{StaticResource ToolBtn}" Click="Open_Click">
                                        <TextBlock Text="Open"/>
                                    </Button>
                                    <Button Style="{StaticResource ToolBtn}" Click="Save_Click">
                                        <TextBlock Text="Save"/>
                                    </Button>
                                    <Button Style="{StaticResource ToolBtn}" Click="Copy_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x29C9;" FontSize="11" Margin="0,0,7,0"/>
                                            <TextBlock Text="Copy"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Button x:Name="AttachButton" Style="{StaticResource ToolBtnAccent}"
                                            Click="AttachButton_Click" Padding="14,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F517;" FontSize="11" Margin="0,0,7,0"/>
                                            <TextBlock Text="Inject" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Editor -->
                        <Border Grid.Row="2" Background="{StaticResource BgEditor}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#08080C"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="0,0,1,0">
                                    <ScrollViewer x:Name="LineNumberScroller"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Hidden">
                                        <TextBlock x:Name="LineNumbers"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextDim}"
                                                   TextAlignment="Right"
                                                   Padding="0,14,12,14"
                                                   Text="1"/>
                                    </ScrollViewer>
                                </Border>

                                <TextBox x:Name="ScriptBox" Grid.Column="1"
                                         Background="Transparent"
                                         Foreground="#E8E8E8"
                                         CaretBrush="{StaticResource Accent}"
                                         SelectionBrush="#4A3F18"
                                         BorderThickness="0"
                                         Padding="14,14,14,14"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="13"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextChanged="ScriptBox_TextChanged"
                                         SelectionChanged="ScriptBox_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <!-- Status bar -->
                        <Border Grid.Row="3" Background="#0A0A0F"
                                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusPill" Text="Not injected"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CursorPosText" Text="Ln 1, Col 1"
                                               FontSize="11" Foreground="{StaticResource TextMuted}"
                                               Margin="0,0,18,0"/>
                                    <TextBlock Text="Spaces: 4" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="0,0,18,0"/>
                                    <TextBlock Text="UTF-8" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="0,0,18,0"/>
                                    <TextBlock Text="Lua" FontSize="11"
                                               Foreground="{StaticResource Accent}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ ACCOUNT VIEW ============ -->
                    <ScrollViewer x:Name="ViewAccount" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="32">
                        <StackPanel>
                            <TextBlock Text="Account" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,4,0,4"/>
                            <TextBlock Text="Sign in with Discord to unlock Vault."
                                       FontSize="12" Foreground="{StaticResource TextMuted}"
                                       Margin="0,0,0,24"/>

                            <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="22" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="{StaticResource Accent}" Margin="0,0,16,0">
                                        <TextBlock Text="V" Foreground="#0A0A0C" FontWeight="Bold"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="AccountNameText" Text="Not signed in"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock x:Name="AccountStatusText"
                                                   Text="Sign in with Discord to continue"
                                                   FontSize="11" Foreground="{StaticResource TextMuted}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="22" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Plan" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="Vault Premium" HorizontalAlignment="Right"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </Grid>
                                    <Separator Background="{StaticResource Border}" Margin="0,0,0,14"/>
                                    <Grid>
                                        <TextBlock Text="Whitelist" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="Active" HorizontalAlignment="Right"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="Sign in with Discord" Padding="20,12"
                                    HorizontalAlignment="Left" FontSize="12.5" FontWeight="SemiBold"
                                    Background="{StaticResource Accent}" Foreground="#0A0A0C"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="DiscordSignIn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#D4AF37" BlurRadius="18"
                                                                  Opacity="0.5" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ SETTINGS VIEW ============ -->
                    <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="32">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,4,0,4"/>
                            <TextBlock Text="Preferences and options."
                                       FontSize="12" Foreground="{StaticResource TextMuted}"
                                       Margin="0,0,0,24"/>

                            <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="24">
                                <TextBlock Text="Settings panel coming next build."
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Attached popup -->
        <Popup x:Name="AttachedPopup"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               Placement="Top" HorizontalOffset="0" VerticalOffset="72"
               AllowsTransparency="True" StaysOpen="False">
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="18,14" Margin="12">
                <Border.Effect>
                    <DropShadowEffect Color="#D4AF37" BlurRadius="24"
                                      Opacity="0.55" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F512;" FontSize="20"
                               Foreground="{StaticResource Accent}"
                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Attached to Client" FontWeight="Bold"
                                   Foreground="{StaticResource Accent}" FontSize="13"/>
                        <TextBlock Text="Vault is ready."
                                   FontSize="11" Foreground="{StaticResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

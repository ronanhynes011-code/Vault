<Window x:Class="Vault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault" Height="680" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#050507"
        Foreground="#E8E8E8"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.35"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <SolidColorBrush x:Key="BgDeep" Color="#050507"/>
        <SolidColorBrush x:Key="BgDark" Color="#0A0A0E"/>
        <SolidColorBrush x:Key="BgPanel" Color="#101016"/>
        <SolidColorBrush x:Key="BgCard" Color="#17171E"/>
        <SolidColorBrush x:Key="BgEditor" Color="#0B0B10"/>
        <SolidColorBrush x:Key="Accent" Color="#D4AF37"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#F0C75E"/>
        <SolidColorBrush x:Key="AccentDim" Color="#6B5A20"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6E6E78"/>
        <SolidColorBrush x:Key="TextDim" Color="#4A4A52"/>
        <SolidColorBrush x:Key="Border" Color="#1E1E26"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2A2A34"/>

        <!-- Window controls -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A22"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWinBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A1414"/>
                    <Setter Property="Foreground" Value="#FF7070"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar nav button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="GlowBar" Width="3" HorizontalAlignment="Left"
                                        Background="{StaticResource Accent}" CornerRadius="2"
                                        Opacity="0" Margin="-14,0,0,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14141B"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#14141B"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border Width="3" HorizontalAlignment="Left"
                                        Background="{StaticResource Accent}" CornerRadius="2"
                                        Margin="-14,0,0,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom bar action button -->
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A8A8B2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A22"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BarBtn}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#1A1610"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#241E12"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Script tab style -->
        <Style x:Key="ScriptTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8,32,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0" Margin="2,4,2,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="2"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" Margin="16,0,0,0"/>
                                <Border x:Name="Underline" Grid.Row="1"
                                        Background="{StaticResource Accent}"
                                        Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14141B"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScriptTabBtnActive" TargetType="Button" BasedOn="{StaticResource ScriptTabBtn}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#0B0B10"
                                CornerRadius="8,8,0,0" Margin="2,4,2,0"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1,1,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="2"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" Margin="16,0,0,0"/>
                                <Border Grid.Row="1" Background="{StaticResource Accent}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round button for tab close -->
        <Style x:Key="CloseDot" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A1414"/>
                                <Setter Property="Foreground" Value="#FF7070"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Ambient radial glow -->
        <Border CornerRadius="12">
            <Border.Background>
                <RadialGradientBrush Center="0.15,0.05" GradientOrigin="0.15,0.05"
                                     RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#1A1408" Offset="0"/>
                    <GradientStop Color="#0A0A0E" Offset="0.4"/>
                    <GradientStop Color="#050507" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#D4AF37" BlurRadius="32" Opacity="0.12"
                                  ShadowDepth="0"/>
            </Border.Effect>
        </Border>

        <!-- Main window shell -->
        <Border CornerRadius="12" Background="Transparent"
                BorderBrush="#1A1A22" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Path Data="M8,0 L16,8 L8,16 L0,8 Z"
                              Fill="{StaticResource Accent}" Width="12" Height="16"
                              Stretch="Uniform" Margin="0,0,10,0">
                            <Path.Effect>
                                <DropShadowEffect Color="#D4AF37" BlurRadius="12" Opacity="0.7"
                                                  ShadowDepth="0"/>
                            </Path.Effect>
                        </Path>
                        <TextBlock Text="Vault" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WinBtn}" Click="Minimize_Click">
                            <TextBlock Text="&#x2014;" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Click="Maximize_Click">
                            <TextBlock Text="&#x25A1;" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource CloseWinBtn}" Click="Close_Click">
                            <TextBlock Text="&#x2715;" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Body -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="#0C0C12"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,1,1,0"
                            CornerRadius="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Brand -->
                            <StackPanel Grid.Row="0" Margin="18,22,18,24">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8,0 L16,8 L8,16 L0,8 Z"
                                          Fill="{StaticResource Accent}" Width="20" Height="26"
                                          Stretch="Uniform" Margin="0,0,10,0">
                                        <Path.Effect>
                                            <DropShadowEffect Color="#D4AF37" BlurRadius="16" Opacity="0.85"
                                                              ShadowDepth="0"/>
                                        </Path.Effect>
                                    </Path>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Vault" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="EXECUTOR" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}"
                                                   LetterSpacing="2" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Nav -->
                            <StackPanel Grid.Row="1">
                                <Button x:Name="NavExecutor" Style="{StaticResource NavBtnActive}"
                                        Click="NavExecutor_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x25C6;" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock Text="Executor"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavScripts" Style="{StaticResource NavBtn}"
                                        Click="NavScripts_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x25A4;" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock Text="Scripts"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavAccount" Style="{StaticResource NavBtn}"
                                        Click="NavAccount_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x25C9;" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock Text="Account"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavSettings" Style="{StaticResource NavBtn}"
                                        Click="NavSettings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x25CB;" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock Text="Settings"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- User card -->
                            <Border Grid.Row="2" Background="#14141B" CornerRadius="9"
                                    Margin="12,0,12,14" Padding="12,10"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            Background="{StaticResource Accent}" Margin="0,0,11,0">
                                        <TextBlock Text="V" Foreground="#0A0A0C" FontWeight="Bold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="SidebarUser" Text="Guest"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock x:Name="SidebarStatus" Text="Not signed in"
                                                   FontSize="10" Foreground="{StaticResource TextMuted}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <Grid Grid.Column="1" Background="#08080C">

                        <!-- EXECUTOR VIEW -->
                        <Grid x:Name="ViewExecutor">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <!-- Script tabs strip -->
                            <Border Grid.Row="0" Background="#0A0A0F"
                                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="ScriptTabsPanel" Orientation="Horizontal"
                                                    Margin="6,0,0,0"/>
                                    </ScrollViewer>

                                    <Button Grid.Column="1" Style="{StaticResource BarBtn}"
                                            Click="AddScriptTab_Click" Margin="6,0,10,0"
                                            Padding="10,6" VerticalAlignment="Center">
                                        <TextBlock Text="+ New" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Editor -->
                            <Border Grid.Row="1" Background="{StaticResource BgEditor}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#08080D"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="0,0,1,0">
                                        <ScrollViewer x:Name="LineNumberScroller"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      HorizontalScrollBarVisibility="Hidden">
                                            <TextBlock x:Name="LineNumbers" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextDim}"
                                                       TextAlignment="Right"
                                                       Padding="0,16,12,16"
                                                       Text="1"/>
                                        </ScrollViewer>
                                    </Border>

                                    <TextBox x:Name="ScriptBox" Grid.Column="1"
                                             Background="Transparent"
                                             Foreground="#E8E8E8"
                                             CaretBrush="{StaticResource Accent}"
                                             SelectionBrush="#4A3F18"
                                             BorderThickness="0"
                                             Padding="14,16,14,16"
                                             FontFamily="Cascadia Mono, Consolas"
                                             FontSize="13"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextChanged="ScriptBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Bottom action bar -->
                            <Border Grid.Row="2" Background="#0C0C12"
                                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <Button x:Name="AttachButton" Style="{StaticResource PrimaryBtn}"
                                                Click="AttachButton_Click" Padding="18,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x1F517;" FontSize="12" Margin="0,0,8,0"/>
                                                <TextBlock Text="Attach" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BarBtn}" Click="Clear_Click">
                                            <TextBlock Text="Clear"/>
                                        </Button>
                                        <Button Style="{StaticResource BarBtn}" Click="Open_Click">
                                            <TextBlock Text="Open"/>
                                        </Button>
                                        <Button Style="{StaticResource BarBtn}" Click="Save_Click">
                                            <TextBlock Text="Save"/>
                                        </Button>
                                        <Button x:Name="ExecuteButton" Style="{StaticResource PrimaryBtn}"
                                                Click="ExecuteButton_Click" Padding="18,8"
                                                Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x25B6;" FontSize="10" Margin="0,0,8,0"/>
                                                <TextBlock Text="Execute" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock x:Name="StatusText" Text="Not Attached"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- SCRIPTS VIEW -->
                        <ScrollViewer x:Name="ViewScripts" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" Padding="32">
                            <StackPanel>
                                <TextBlock Text="Scripts" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" Margin="0,4,0,4"/>
                                <TextBlock Text="Manage and load your saved scripts."
                                           FontSize="12" Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,0,24"/>

                                <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="24" Margin="0,0,0,12">
                                    <TextBlock Text="Script library coming next build."
                                               FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ACCOUNT VIEW -->
                        <ScrollViewer x:Name="ViewAccount" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" Padding="32">
                            <StackPanel>
                                <TextBlock Text="Account" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" Margin="0,4,0,4"/>
                                <TextBlock Text="Sign in with Discord to unlock Vault."
                                           FontSize="12" Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,0,24"/>

                                <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="22" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="52" Height="52" CornerRadius="26"
                                                Background="{StaticResource Accent}" Margin="0,0,16,0">
                                            <TextBlock Text="V" Foreground="#0A0A0C" FontWeight="Bold"
                                                       FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="AccountNameText" Text="Not signed in"
                                                       FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock x:Name="AccountStatusText"
                                                       Text="Sign in with Discord to continue"
                                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="22" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <TextBlock Text="Plan" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock Text="Vault Premium" HorizontalAlignment="Right"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Grid>
                                        <Separator Background="{StaticResource Border}" Margin="0,0,0,14"/>
                                        <Grid>
                                            <TextBlock Text="Whitelist" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock Text="Active" HorizontalAlignment="Right"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Content="Sign in with Discord" Padding="20,12"
                                        HorizontalAlignment="Left" FontSize="12.5" FontWeight="SemiBold"
                                        Background="{StaticResource Accent}" Foreground="#0A0A0C"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="DiscordSignIn_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#D4AF37" BlurRadius="18"
                                                                      Opacity="0.5" ShadowDepth="0"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- SETTINGS VIEW -->
                        <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" Padding="32">
                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" Margin="0,4,0,4"/>
                                <TextBlock Text="Preferences and options."
                                           FontSize="12" Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,0,24"/>

                                <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="24">
                                    <TextBlock Text="Settings panel coming next build."
                                               FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Attached popup -->
        <Popup x:Name="AttachedPopup"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               Placement="Top" HorizontalOffset="0" VerticalOffset="72"
               AllowsTransparency="True" StaysOpen="False">
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="18,14" Margin="12">
                <Border.Effect>
                    <DropShadowEffect Color="#D4AF37" BlurRadius="24"
                                      Opacity="0.55" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F512;" FontSize="20"
                               Foreground="{StaticResource Accent}"
                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Attached to Client" FontWeight="Bold"
                                   Foreground="{StaticResource Accent}" FontSize="13"/>
                        <TextBlock Text="Vault is ready."
                                   FontSize="11" Foreground="{StaticResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window><Window x:Class="Vault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault" Height="600" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0C"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0A0A0C"/>
        <SolidColorBrush x:Key="BgPanel" Color="#141418"/>
        <SolidColorBrush x:Key="BgCard" Color="#1C1C22"/>
        <SolidColorBrush x:Key="BgEditor" Color="#0D0D10"/>
        <SolidColorBrush x:Key="AccentGold" Color="#D4AF37"/>
        <SolidColorBrush x:Key="AccentGoldHover" Color="#F0C75E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7A7A82"/>
        <SolidColorBrush x:Key="BorderColor" Color="#22222A"/>
        <SolidColorBrush x:Key="LineNumber" Color="#3A3A44"/>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F1F26"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A1414"/>
                    <Setter Property="Foreground" Value="#FF6B6B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabBtnActive" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="Background" Value="{StaticResource BgEditor}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0B0B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F1F26"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBarBtn" TargetType="Button" BasedOn="{StaticResource BarBtn}">
            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2410"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentGoldHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="10" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <TextBlock Text="Vault" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource WinBtn}" Click="Minimize_Click">
                            <TextBlock Text="&#x2014;" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Click="Maximize_Click">
                            <TextBlock Text="&#x25A1;" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource CloseBtn}" Click="Close_Click">
                            <TextBlock Text="&#x2715;" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Background="{StaticResource BgPanel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="AccountTabBtn" Style="{StaticResource TabBtn}"
                                Click="AccountTab_Click" Content="Account"/>
                        <Button x:Name="ScriptTabBtn" Style="{StaticResource TabBtnActive}"
                                Click="ScriptTab_Click" Content="Script"/>
                        <Button Style="{StaticResource TabBtn}" Content="+" FontSize="14" Padding="12,4" Click="NewTab_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="&#x1F50D;" FontSize="12"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                </Grid>

                <Grid Grid.Row="2">

                    <ScrollViewer x:Name="AccountPanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Account" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource AccentGold}" Margin="0,4,0,20"/>

                            <Border Background="{StaticResource BgPanel}" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    Padding="18" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="44" CornerRadius="22"
                                            Background="{StaticResource AccentGold}" Margin="0,0,14,0">
                                        <TextBlock Text="V" Foreground="#0A0A0C" FontWeight="Bold"
                                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="AccountNameText" Text="Not signed in"
                                                   FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AccountStatusText" Text="Sign in with Discord to continue"
                                                   FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BgPanel}" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    Padding="18" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Plan" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="Vault Premium" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Separator Background="{StaticResource BorderColor}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <TextBlock Text="Status" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="Whitelisted" HorizontalAlignment="Right" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentGold}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="Sign in with Discord" Padding="16,10"
                                    HorizontalAlignment="Left" FontSize="12" FontWeight="SemiBold"
                                    Background="{StaticResource AccentGold}" Foreground="#0A0A0C"
                                    BorderThickness="0" Cursor="Hand" Click="DiscordSignIn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ScriptPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BgEditor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource BgEditor}">
                                    <ScrollViewer x:Name="LineNumberScroller" VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Hidden">
                                        <TextBlock x:Name="LineNumbers" FontFamily="Consolas" FontSize="13"
                                                   Foreground="{StaticResource LineNumber}"
                                                   TextAlignment="Right" Padding="0,12,8,12"
                                                   Text="1"/>
                                    </ScrollViewer>
                                </Border>

                                <TextBox x:Name="ScriptBox" Grid.Column="1"
                                         Background="Transparent"
                                         Foreground="#E8E8E8"
                                         CaretBrush="{StaticResource AccentGold}"
                                         BorderThickness="0"
                                         Padding="10,12,12,12"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextChanged="ScriptBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="AttachButton" Style="{StaticResource PrimaryBarBtn}"
                                            Click="AttachButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F517;" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Attach"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BarBtn}" Click="Clear_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2327;" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Clear"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BarBtn}" Click="Open_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F4C2;" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Open"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BarBtn}" Click="Save_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F4BE;" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Save"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ExecuteButton" Style="{StaticResource PrimaryBarBtn}"
                                            Click="ExecuteButton_Click" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x25B6;" FontSize="10" Margin="0,0,6,0"/>
                                            <TextBlock Text="Execute"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock x:Name="StatusText" Text="Not Attached"
                                           Foreground="{StaticResource TextMuted}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Popup x:Name="AttachedPopup"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               Placement="Top" HorizontalOffset="0" VerticalOffset="60"
               AllowsTransparency="True" StaysOpen="False">
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource AccentGold}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F512;" FontSize="18" Foreground="{StaticResource AccentGold}"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Attached to Client" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGold}"/>
                        <TextBlock Text="Vault is ready." FontSize="11"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
